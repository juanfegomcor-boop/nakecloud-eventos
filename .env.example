# Base de datos (Vercel la llena sola al conectar Neon desde la pestaña Storage)
DATABASE_URL=

# Acceso al panel /admin
ADMIN_PASSWORD=
# Cadena larga al azar para firmar la sesión del panel
SESSION_SECRET=

# Wompi (Desarrolladores > Llaves y Secretos para integración técnica)
# Pruebas: pub_test_...  · Producción: pub_prod_...
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Opcional: dominio final, por ejemplo https://eventos.nakecloud.co
SITE_URL=
